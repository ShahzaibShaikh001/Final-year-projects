# Required — get a key at https://console.groq.com/
GROQ_API_KEY=

# Optional — improves Google Scholar results (https://serpapi.com/)
SERPAPI_KEY=

# Optional — IEEE Xplore API key (https://developer.ieee.org/)
IEEE_API_KEY=

# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Used for polite API identification (Crossref / Unpaywall / OpenAlex)
CONTACT_EMAIL=you@example.com
